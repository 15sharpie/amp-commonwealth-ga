Meta.DisplayName=Global Agenda (Commonwealth)
Meta.Description=Global Agenda private server using the open-source Commonwealth control server. Runs the real game server under Wine.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=15sharpie (AMP template), commonwealthga (server)
Meta.URL=https://github.com/commonwealthga/commonwealth-ga-server
Meta.DisplayImageSource=steam:17020
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ApplicationPort1}
Meta.ConfigManifest=commonwealthgaconfig.json
Meta.MetaConfigManifest=commonwealthgametaconfig.json
Meta.ConfigRoot=commonwealthga.kvp
Meta.MinAMPVersion=2.5.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:wine-10-stable
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RequiredOnLinux
Meta.ContainerPolicyReason=The control server launches the Windows game server with Wine and Xvfb, which the wine-stable container image provides.
Meta.ExtraContainerPackages=[]
Meta.Prerequisites=[]
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=6
Meta.AppConfigId=5f0d8a63-3c1e-4b52-9d1a-7e2c4a9b6f10
Meta.NoCommercialUsage=True
App.DisplayName=Global Agenda (Commonwealth)
App.RootDir=./commonwealthga/
App.BaseDirectory=./commonwealthga/
App.ExecutableWin=
App.ExecutableLinux=control-server
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--config {{$FullBaseDir}}control-server.json
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[commonwealthgaports.json]
App.PrimaryApplicationPortRef=ApplicationPort1
App.AdminPortRef=0
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=64
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.UpdateSources=@IncludeJson[commonwealthgaupdates.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
App.MonitorChildProcessName=
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.AppReadyRegex=^\[.+?\] \[main\] Binding TCP listener on port \d+$
Console.UserJoinRegex=^\[[^\]]+\] \[chat\] \[Chat\] (?:\w+ )?bound player='(?<username>[^']+)' guid=(?<userid>[0-9a-fA-F]+)\s*$
Console.UserLeaveRegex=^\[[^\]]+\] \[chat\] \[Chat\] tearing down player='(?<username>[^']+)' guid=(?<userid>[0-9a-fA-F]+).*$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
